<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Veleiro Ticket Intake User</label>
    <description>Para la gente del CLIENTE: levanta tickets, los ve y sigue su avance. No alcanza la configuracion del paquete ni el token — eso vive en Veleiro Ticket Admin, que el partner se asigna a si mismo.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <applicationVisibilities>
        <application>Veleiro_Ticket_Intake</application>
        <visible>true</visible>
    </applicationVisibilities>

    <classAccesses>
        <apexClass>VeleiroTicketApiClient</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>VeleiroTicketService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>VeleiroTicketController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>VeleiroTicketPushQueueable</apexClass>
        <enabled>true</enabled>
    </classAccesses>

